{
  "name": "@arc-skill-eval/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix .. --workspace @arc-skill-eval/tokens run build && node scripts/dev.mjs",
    "dev:web-only": "npm --prefix .. --workspace @arc-skill-eval/tokens run build && vite --host 127.0.0.1",
    "daemon": "npm --prefix daemon start",
    "build": "npm --prefix .. --workspace @arc-skill-eval/tokens run build && vite build",
    "preview": "npm --prefix .. --workspace @arc-skill-eval/tokens run build && vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arc-skill-eval/tokens": "0.1.0",
    "@effect/platform-browser": "4.1.5",
    "effect": "4.1.5",
    "foldkit": "0.171.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.29.1",
    "@playwright/test": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
