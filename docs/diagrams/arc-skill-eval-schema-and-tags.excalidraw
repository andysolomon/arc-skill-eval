      "link": null,
      "locked": false,
      "text": "{\n  \"version\": \"1\",\n  \"skill_name\": \"arc-conventional-commits\",\n  \"evals\": [{\n    \"id\": \"trigger-explicit-named\",\n    \"description\": \"optional\",\n    \"prompt\": \"Use the skill...\",\n    \"expected_output\": \"success criteria\",\n    \"setup\": { \"kind\": \"empty|seeded|fixture\" },\n    \"sandbox\": \"none|just-bash\",\n    \"sandboxMocks\": [{ \"command\": \"npm\" }],\n    \"metadata\": {\n      \"tags\": [\"trigger\", \"positive\"],\n      \"difficulty\": \"easy|medium|hard\",\n      \"intent\": \"explicit-trigger\"\n    },\n    \"assertions\": [ ... ]\n  }]\n}",
      "originalText": "{\n  \"version\": \"1\",\n  \"skill_name\": \"arc-conventional-commits\",\n  \"evals\": [{\n    \"id\": \"trigger-explicit-named\",\n    \"description\": \"optional\",\n    \"prompt\": \"Use the skill...\",\n    \"expected_output\": \"success criteria\",\n    \"setup\": { \"kind\": \"empty|seeded|fixture\" },\n    \"sandbox\": \"none|just-bash\",\n    \"sandboxMocks\": [{ \"command\": \"npm\" }],\n    \"metadata\": {\n      \"tags\": [\"trigger\", \"positive\"],\n      \"difficulty\": \"easy|medium|hard\",\n      \"intent\": \"explicit-trigger\"\n    },\n    \"assertions\": [ ... ]\n  }]\n}",
