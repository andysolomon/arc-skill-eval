{
  "name": "arc-skill-eval",
  "version": "0.21.0",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "description": "Pi-native library and CLI that runs Anthropic-standard skill evals (evals/evals.json) with LLM-judged + script assertions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andysolomon/arc-skill-eval.git"
  },
  "homepage": "https://github.com/andysolomon/arc-skill-eval",
  "bugs": {
    "url": "https://github.com/andysolomon/arc-skill-eval/issues"
  },
  "keywords": [
    "pi",
    "skills",
    "evaluation",
    "semantic-release",
    "typescript"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "!**/evals-runs/**"
  ],
  "bin": {
    "arc-skill-eval": "dist/bin/arc-skill-eval.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release": "semantic-release",
    "test": "npm run build && node --test tests/*.test.mjs",
    "docs:keymap": "npm run build && node scripts/gen-keymap-docs.mjs",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm run docs:keymap && npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview",
    "docs:check": "npm --prefix docs-site run check"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.31",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "ink-testing-library": "^4.0.0",
    "semantic-release": "^24.2.3"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "just-bash": "^3.0.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@lmnr-ai/lmnr": "^0.8.36"
  }
}
